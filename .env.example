# All-Sport Intelligence Platform — environment variable template
# Copy to .env and fill in real values. NEVER commit .env. Names only here — no secrets.

# --- Database (Phase 1) ---
# PostgreSQL connection string for the platform's system of record.
DATABASE_URL=postgresql://user:password@localhost:5432/all_sport

# --- MLB (keyless; no credentials required) ---
# MLB Stats API and Baseball Savant are public. These are base URLs, overridable for testing.
MLB_STATS_API_BASE_URL=https://statsapi.mlb.com/api
BASEBALL_SAVANT_BASE_URL=https://baseballsavant.mlb.com

# --- Tennis LIVE providers (server-side only; app is inert without these) ---
# Obtain from the vendor. Without a key the corresponding provider reports "unconfigured"
# and the UI shows "Live Tennis provider not configured" — it never fabricates data.
SPORTRADAR_TENNIS_API_KEY=
SPORTSDATAIO_TENNIS_API_KEY=
API_TENNIS_API_KEY=

# --- Tennis HISTORICAL (Sackmann; non-commercial CC BY-NC-SA) ---
# Local path or git URL to the historical CSV corpus used for backtesting/research ONLY.
TENNIS_HISTORICAL_CORPUS_PATH=

# --- Observability (Phase 1+) ---
LOG_LEVEL=info

# --- Feature flags ---
# Never enable fixture data in production paths. Tests/dev only.
ALLOW_FIXTURES=false
