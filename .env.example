# All-Sport Intelligence Platform — environment variable template
# Copy to .env and fill in real values. NEVER commit .env. Names only here — no secrets.

# ============================================================================
# REQUIRED infrastructure (app fails fast at startup if missing)
# ============================================================================

# PostgreSQL connection string — the platform's system of record.
# Matches the docker-compose.yml dev defaults below.
DATABASE_URL=postgresql://allsport:allsport_dev_pw@localhost:5432/all_sport

# ============================================================================
# docker-compose Postgres dev credentials (used only by docker-compose.yml)
# ============================================================================
POSTGRES_USER=allsport
POSTGRES_PASSWORD=allsport_dev_pw
POSTGRES_DB=all_sport
POSTGRES_PORT=5432

# ============================================================================
# OPTIONAL provider credentials — server-side only.
# Missing keys must NEVER crash startup; the provider reports PROVIDER_NOT_CONFIGURED.
# Do NOT prefix any of these with NEXT_PUBLIC_ (that would leak them to the browser).
# ============================================================================

# MLB is keyless/public — no credentials required. Base URLs are overridable for tests.
MLB_STATS_API_BASE_URL=https://statsapi.mlb.com/api
BASEBALL_SAVANT_BASE_URL=https://baseballsavant.mlb.com

# Tennis LIVE — Sportradar Tennis v3 (primary live candidate). Commercial license.
SPORTRADAR_TENNIS_API_KEY=

# Tennis LIVE — SportsDataIO Tennis (odds/market cross-source).
# NOTE: free-trial responses are SCRAMBLED-but-realistic -> classified `trial_scrambled`,
# never treated as production truth. Header: Ocp-Apim-Subscription-Key.
SPORTSDATAIO_TENNIS_API_KEY=

# Tennis LIVE — Provider A: api-tennis.com (own infrastructure; `APIkey` auth).
API_TENNIS_API_KEY=

# Tennis LIVE — Provider B: tennis-api.com via RapidAPI (DISTINCT vendor from api-tennis.com).
# Auth headers: X-RapidAPI-Key + X-RapidAPI-Host.
TENNIS_API_RAPIDAPI_KEY=
TENNIS_API_RAPIDAPI_HOST=tennis-api-atp-wta-itf.p.rapidapi.com

# Tennis HISTORICAL — Jeff Sackmann (non-commercial CC BY-NC-SA). Research plane ONLY.
TENNIS_HISTORICAL_CORPUS_PATH=

# ============================================================================
# Observability / feature flags
# ============================================================================
LOG_LEVEL=info
# Never enable fixture data in production paths. Tests/dev only.
ALLOW_FIXTURES=false
